{
    "name": "solid-lib",
    "version": "0.0.0",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/_.ts",
            "import": "./src/_.ts"
        },
        "./ui.css": "./src/_.css"
    },
    "files": [
        "docs",
        "src",
        "README.md",
        "tsconfig.json"
    ],
    "scripts": {
        "test": "bun run test:unit",
        "test:local-consumer": "bun ./test/demo-local-consumer.ts",
        "test:packed-consumer": "bun ./test/demo-local-consumer.ts pack",
        "test:smoke": "bun run test:local-consumer && bun run test:packed-consumer",
        "test:unit": "bun test"
    },
    "dependencies": {
        "@solidjs/web": "2.0.0-rc.3"
    },
    "devDependencies": {
        "@types/bun": "1.4.0",
        "solid-js": "2.0.0-rc.3",
        "typescript": "7.0.2"
    },
    "peerDependencies": {
        "solid-js": "2.0.0-rc.3"
    }
}
